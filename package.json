{
  "name": "side-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open X, Bluesky and Threads post detail in a side column instead of navigating away.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "check": "biome check --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "^30.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "eslint",
        "web-ext"
      ]
    },
    "overrides": {
      "@vitejs/plugin-react": "5.2.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "@parcel/watcher",
      "@biomejs/biome",
      "unrs-resolver",
      "rolldown"
    ]
  }
}
